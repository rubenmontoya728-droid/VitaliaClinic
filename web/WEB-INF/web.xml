<?xml version="1.0" encoding="UTF-8"?>

<web-app
    xmlns="https://jakarta.ee/xml/ns/jakartaee"
    version="5.0">

<!-- Servlet base -->
    <servlet>
        <servlet-name>RegistroServlet</servlet-name>

        <servlet-class>
            com.vitaliaclinic.servlet.RegistroServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegistroServlet</servlet-name>

        <url-pattern>/registro</url-pattern>
    </servlet-mapping>
<!-- FIN DE SERVLET BASE -->
<!-- SERVLET PARA LOGIN -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>
            com.vitaliaclinic.servlet.LoginServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
<!-- FIN DE SERVLET PARA LOGIN -->
<!-- SERVLET PARA LOGOUT -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>
            com.vitaliaclinic.servlet.LogoutServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
<!-- FIN DE SERVLET PARA LOGOUT -->
</web-app>